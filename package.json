{
  "name": "facturepro",
  "productName": "FacturePro",
  "version": "2.1.0",
  "description": "FacturePro — Logiciel de facturation professionnel français, hors ligne.",
  "author": {
    "name": "FacturePro",
    "email": "contact@facturepro.local"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,APP -c cyan,magenta \"vite\" \"wait-on tcp:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "node scripts/prepare-assets.mjs && npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:linux-check": "npm run build && electron-builder --dir --win --x64",
    "preview": "node scripts/build-preview.mjs && node scripts/preview-server-run.mjs",
    "test:e2e": "node scripts/build-preview.mjs && node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "pdf:render": "node scripts/pdf-render.mjs",
    "seed:preview": "node scripts/seed-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "adm-zip": "^0.6.0",
    "lucide-react": "^0.545.0",
    "pdfkit": "^0.20.2",
    "sql.js": "^1.15.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^5.4.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.0",
    "roboto-fontface": "^0.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "fr.facturepro.app",
    "productName": "FacturePro",
    "copyright": "© 2026 FacturePro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/{test,tests,__tests__}/**"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "asarUnpack": [
      "node_modules/pdfkit/**",
      "node_modules/fontkit/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FacturePro",
      "uninstallDisplayName": "FacturePro",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
